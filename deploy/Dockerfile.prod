FROM python:3.11-slim

WORKDIR /app
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    PIP_TRUSTED_HOST=mirrors.aliyun.com PIP_DEFAULT_TIMEOUT=120

RUN sed -i \
      -e 's|http://deb.debian.org/debian-security|http://mirrors.aliyun.com/debian-security|g' \
      -e 's|http://deb.debian.org/debian|http://mirrors.aliyun.com/debian|g' \
      /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl \
       tesseract-ocr tesseract-ocr-chi-sim \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-daq.txt requirements.txt ./
RUN pip install -r requirements-daq.txt

COPY daq_fae ./daq_fae
COPY src ./src
COPY scripts ./scripts
COPY deploy/provision_env.py ./deploy/provision_env.py
COPY deploy/normalize_code_permissions.py /tmp/daq-normalize-code-permissions.py
COPY migrations ./migrations
COPY prompts ./prompts
COPY upstream-source.json ./upstream-source.json
COPY webui/dist ./webui/dist
RUN mkdir -p /app/knowledge /app/data/knowledge/published /app/data/knowledge/sdk-published /app/data/attachments \
    && chmod 700 /app/data/attachments
RUN python -B /tmp/daq-normalize-code-permissions.py --apply && rm /tmp/daq-normalize-code-permissions.py
USER 21081:21081

EXPOSE 8081
CMD ["uvicorn", "daq_fae.app:app", "--host", "0.0.0.0", "--port", "8081"]
